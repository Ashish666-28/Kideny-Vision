FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HOST=0.0.0.0 \
    PORT=80 \
    STATELESS_SESSIONS=1 \
    OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1

WORKDIR /app

COPY requirements.txt .
RUN pip install --upgrade pip \
    && pip install "torch>=2.6,<3" --index-url https://download.pytorch.org/whl/cpu \
    && pip install -r requirements.txt gunicorn

COPY . .

EXPOSE 80
CMD ["sh", "-c", "exec gunicorn --bind 0.0.0.0:${PORT:-80} --workers 1 --threads 4 --timeout 300 app:app"]
