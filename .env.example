# Copy to .env and supply your own Google Gemini API key locally.
GOOGLE_API_KEY=your_google_api_key_here

# Optional; this is the default configured by chatbot.py.
GEMINI_MODEL=gemini-flash-latest

# Optional; Flask generates a random secret when this value is empty.
FLASK_SECRET_KEY=

# Oracle VM: set this to the public domain or IP used in the browser.
TRUSTED_HOSTS=
